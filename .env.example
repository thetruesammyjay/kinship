# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kinship

# Redis / Upstash
REDIS_URL=rediss://default:password@host.upstash.io:6379

# API security
APP_DEBUG=true
JWT_SECRET=change-me-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kinship verification
RELATEDNESS_THRESHOLD_DEGREE=2

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.example

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional email provider
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional object storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
