# FastAPI backend base URL (includes the /api/v1 prefix).
# Local dev: the API runs on port 8000 (see apps/api README).
# Deployed: point at the Hugging Face Space URL, e.g.
#   https://<owner>-<space>.hf.space/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public Vercel URL used for canonical and social metadata.
# Production: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
